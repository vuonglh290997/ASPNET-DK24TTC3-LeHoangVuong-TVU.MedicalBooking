@page
@model TVU.MedicalBooking.Pages.Doctors.AppointmentDetailModel
@{
    ViewData["Title"] = "Chi tiết lịch hẹn";
    Layout = "_Layout";
}
<div class="container-fluid mt-4 mb-5">
    <div class="row">
        <div class="col-12 mb-3">
            <a asp-page="/Doctor/Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại Dashboard
            </a>
        </div>
    </div>
    
    @if (Model.Appointment != null)
    {
        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8 mb-4">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-calendar-check"></i> 
                                Chi Tiết Lịch Hẹn #@Model.Appointment.AppointmentId
                            </h5>
                            <span class="badge bg-@GetStatusBadgeColor(Model.Appointment.Status) fs-6">
                                @GetStatusText(Model.Appointment.Status)
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Action Buttons (if Pending) -->
                        @if (Model.Appointment.Status == "Pending")
                        {
                            <div class="alert alert-warning mb-4">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>Lịch hẹn chờ duyệt!</strong> Vui lòng xem xét và phê duyệt hoặc từ chối lịch hẹn này.
                            </div>
                            
                            <div class="row mb-4">
                                <div class="col-md-6 mb-2">
                                    <button type="button" class="btn btn-success w-100 btn-lg" 
                                            data-bs-toggle="modal" data-bs-target="#approveModal">
                                        <i class="fas fa-check-circle"></i> Duyệt Lịch Hẹn
                                    </button>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <button type="button" class="btn btn-danger w-100 btn-lg" 
                                            data-bs-toggle="modal" data-bs-target="#rejectModal">
                                        <i class="fas fa-times-circle"></i> Từ Chối
                                    </button>
                                </div>
                            </div>
                        }
                        
                        <!-- Schedule Info -->
                        <div class="mb-4">
                            <h6 class="border-bottom pb-2 mb-3">
                                <i class="fas fa-clock"></i> Thời Gian Khám
                            </h6>
                            <div class="alert alert-info">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h4 class="mb-0">
                                            <i class="fas fa-calendar-day"></i> 
                                            @Model.Appointment.AppointmentDate.ToString("dd/MM/yyyy")
                                        </h4>
                                        <small>@Model.Appointment.AppointmentDate.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</small>
                                    </div>
                                    <div class="col-md-6 text-md-end">
                                        <h4 class="mb-0">
                                            <i class="fas fa-clock"></i> 
                                            @Model.Appointment.TimeSlot
                                        </h4>
                                        <small>Thời gian: @Model.Appointment.Service.DurationMinutes phút</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Service Info -->
                        <div class="mb-4">
                            <h6 class="border-bottom pb-2 mb-3">
                                <i class="fas fa-stethoscope"></i> Dịch Vụ Khám
                            </h6>
                            <table class="table table-borderless">
                                <tr>
                                    <td width="35%"><strong>Dịch vụ:</strong></td>
                                    <td>@Model.Appointment.Service.ServiceName</td>
                                </tr>
                                <tr>
                                    <td><strong>Mô tả:</strong></td>
                                    <td>@Model.Appointment.Service.Description</td>
                                </tr>
                                <tr>
                                    <td><strong>Giá dịch vụ:</strong></td>
                                    <td><strong class="text-success">@Model.Appointment.Service.Price.ToString("N0") VNĐ</strong></td>
                                </tr>
                            </table>
                        </div>
                        
                        <!-- Patient Reason -->
                        @if (!string.IsNullOrEmpty(Model.Appointment.Reason))
                        {
                            <div class="mb-4">
                                <h6 class="border-bottom pb-2 mb-3">
                                    <i class="fas fa-notes-medical"></i> Lý Do Khám / Triệu Chứng
                                </h6>
                                <div class="alert alert-light">
                                    <p class="mb-0" style="white-space: pre-wrap;">@Model.Appointment.Reason</p>
                                </div>
                            </div>
                        }
                        
                        <!-- Doctor Notes -->
                        <div class="mb-4">
                            <h6 class="border-bottom pb-2 mb-3">
                                <i class="fas fa-file-medical"></i> Ghi Chú Của Bác Sĩ
                            </h6>
                            @if (Model.Appointment.Status == "Pending" || Model.Appointment.Status == "Approved")
                            {
                                <form method="post" asp-page-handler="UpdateNotes">
                                    <input type="hidden" name="appointmentId" value="@Model.Appointment.AppointmentId" />
                                    <div class="mb-3">
                                        <textarea name="notes" class="form-control" rows="4" 
                                                  placeholder="Nhập ghi chú, chẩn đoán, khuyến nghị...">@Model.Appointment.Notes</textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save"></i> Lưu Ghi Chú
                                    </button>
                                </form>
                            }
                            else
                            {
                                @if (!string.IsNullOrEmpty(Model.Appointment.Notes))
                                {
                                    <div class="alert alert-info">
                                        <p class="mb-0" style="white-space: pre-wrap;">@Model.Appointment.Notes</p>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">Chưa có ghi chú</p>
                                }
                            }
                        </div>
                        
                        <!-- Payment Status -->
                        @if (Model.Appointment.Payment != null)
                        {
                            <div class="mb-4">
                                <h6 class="border-bottom pb-2 mb-3">
                                    <i class="fas fa-money-bill-wave"></i> Trạng Thái Thanh Toán
                                </h6>
                                <div class="alert alert-@(Model.Appointment.Payment.Status == "Completed" ? "success" : "warning")">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <strong>Số tiền:</strong> @Model.Appointment.Payment.Amount?.ToString("N0") VNĐ
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Trạng thái:</strong> 
                                            @if (Model.Appointment.Payment.Status == "Completed")
                                            {
                                                <span class="badge bg-success">Đã thanh toán</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Chưa thanh toán</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        <!-- Timeline -->
                        <div class="mb-4">
                            <h6 class="border-bottom pb-2 mb-3">
                                <i class="fas fa-history"></i> Lịch Sử
                            </h6>
                            <div class="timeline">
                                <div class="timeline-item completed">
                                    <div class="timeline-marker"><i class="fas fa-check"></i></div>
                                    <div class="timeline-content">
                                        <h6>Bệnh nhân đặt lịch</h6>
                                        <small>@Model.Appointment.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                </div>
                                
                                @if (Model.Appointment.ApprovedAt.HasValue)
                                {
                                    <div class="timeline-item completed">
                                        <div class="timeline-marker"><i class="fas fa-user-check"></i></div>
                                        <div class="timeline-content">
                                            <h6>
                                                @if (Model.Appointment.Status == "Approved")
                                                {
                                                    <text>Đã duyệt lịch hẹn</text>
                                                }
                                                else if (Model.Appointment.Status == "Rejected")
                                                {
                                                    <text>Đã từ chối lịch hẹn</text>
                                                }
                                            </h6>
                                            <small>@Model.Appointment.ApprovedAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <!-- Complete Button (if Approved) -->
                        @if (Model.Appointment.Status == "Approved")
                        {
                            <div class="d-grid">
                                <button type="button" class="btn btn-info btn-lg" 
                                        data-bs-toggle="modal" data-bs-target="#completeModal">
                                    <i class="fas fa-check-double"></i> Đánh Dấu Hoàn Thành
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <!-- Sidebar - Patient Info -->
            <div class="col-lg-4">
                <div class="card shadow mb-4">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0">
                            <i class="fas fa-user"></i> Thông Tin Bệnh Nhân
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <div class="avatar-circle mx-auto mb-3">
                                <i class="fas fa-user fa-3x text-info"></i>
                            </div>
                            <h5 class="mb-1">@Model.Appointment.Patient.User.FullName</h5>
                        </div>
                        
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td><i class="fas fa-id-card text-muted"></i></td>
                                <td><strong>CMND/CCCD:</strong></td>
                                <td>@Model.Appointment.Patient.IdentityCard</td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-birthday-cake text-muted"></i></td>
                                <td><strong>Ngày sinh:</strong></td>
                                <td>@Model.Appointment.Patient.DateOfBirth?.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-venus-mars text-muted"></i></td>
                                <td><strong>Giới tính:</strong></td>
                                <td>@Model.Appointment.Patient.Gender</td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-phone text-muted"></i></td>
                                <td><strong>Điện thoại:</strong></td>
                                <td>@Model.Appointment.Patient.User.PhoneNumber</td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-envelope text-muted"></i></td>
                                <td><strong>Email:</strong></td>
                                <td><small>@Model.Appointment.Patient.User.Email</small></td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-map-marker-alt text-muted"></i></td>
                                <td><strong>Địa chỉ:</strong></td>
                                <td><small>@Model.Appointment.Patient.Address</small></td>
                            </tr>
                        </table>
                        
                        @if (!string.IsNullOrEmpty(Model.Appointment.Patient.EmergencyContact))
                        {
                            <div class="border-top pt-3 mt-3">
                                <h6 class="text-danger">
                                    <i class="fas fa-exclamation-triangle"></i> Liên hệ khẩn cấp
                                </h6>
                                <p class="mb-1"><strong>@Model.Appointment.Patient.EmergencyContact</strong></p>
                                <p class="mb-0"><i class="fas fa-phone"></i> @Model.Appointment.Patient.EmergencyPhone</p>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.Appointment.Patient.MedicalHistory))
                        {
                            <div class="border-top pt-3 mt-3">
                                <h6><i class="fas fa-notes-medical"></i> Tiền sử bệnh</h6>
                                <p class="small mb-0" style="white-space: pre-wrap;">@Model.Appointment.Patient.MedicalHistory</p>
                            </div>
                        }
                    </div>
                </div>
                
                <!-- Quick Actions -->
                <div class="card shadow">
                    <div class="card-header bg-secondary text-white">
                        <h6 class="mb-0"><i class="fas fa-bolt"></i> Thao Tác Nhanh</h6>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a href="tel:@Model.Appointment.Patient.User.PhoneNumber" class="btn btn-outline-success">
                                <i class="fas fa-phone"></i> Gọi điện
                            </a>
                            <a href="mailto:@Model.Appointment.Patient.User.Email" class="btn btn-outline-primary">
                                <i class="fas fa-envelope"></i> Gửi Email
                            </a>
                            <button class="btn btn-outline-info" onclick="window.print()">
                                <i class="fas fa-print"></i> In thông tin
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <h5><i class="fas fa-exclamation-triangle"></i> Không Tìm Thấy</h5>
            <p>Lịch hẹn không tồn tại hoặc bạn không có quyền truy cập.</p>
        </div>
    }
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Xác Nhận Duyệt Lịch Hẹn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Approve">
                <div class="modal-body">
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i>
                        Bạn có chắc muốn duyệt lịch hẹn này?
                    </div>
                    <p><strong>Bệnh nhân:</strong> @Model.Appointment?.Patient?.User?.FullName</p>
                    <p><strong>Ngày khám:</strong> @Model.Appointment?.AppointmentDate.ToString("dd/MM/yyyy") - @Model.Appointment?.TimeSlot</p>
                    <p><strong>Dịch vụ:</strong> @Model.Appointment?.Service?.ServiceName</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check"></i> Xác Nhận Duyệt
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Từ Chối Lịch Hẹn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Reject">
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        Vui lòng cho biết lý do từ chối để bệnh nhân hiểu rõ.
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lý do từ chối *</label>
                        <textarea name="reason" class="form-control" rows="4" required
                                  placeholder="VD: Lịch đã đầy, thời gian không phù hợp, cần thêm thông tin..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times"></i> Xác Nhận Từ Chối
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Complete Modal -->
<div class="modal fade" id="completeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Hoàn Thành Lịch Khám</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Complete">
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        Đánh dấu lịch khám này đã hoàn thành
                    </div>
                    <p>Bạn đã khám xong cho bệnh nhân này?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-info">
                        <i class="fas fa-check-double"></i> Xác Nhận Hoàn Thành
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeColor(string status)
    {
        return status switch
        {
            "Pending" => "warning",
            "Approved" => "success",
            "Completed" => "info",
            "Cancelled" => "danger",
            "Rejected" => "dark",
            _ => "secondary"
        };
    }
    
    string GetStatusText(string status)
    {
        return status switch
        {
            "Pending" => "Chờ duyệt",
            "Approved" => "Đã duyệt",
            "Completed" => "Hoàn thành",
            "Cancelled" => "Đã hủy",
            "Rejected" => "Bị từ chối",
            _ => status
        };
    }
}

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding-left: 40px;
        }
        .timeline-item {
            position: relative;
            padding-bottom: 30px;
        }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -28px;
            top: 30px;
            width: 2px;
            height: calc(100% - 30px);
            background: #dee2e6;
        }
        .timeline-item:last-child::before {
            display: none;
        }
        .timeline-marker {
            position: absolute;
            left: -40px;
            top: 0;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #dee2e6;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }
        .timeline-item.completed .timeline-marker {
            background: #28a745;
        }
        .avatar-circle {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 3px solid #17a2b8;
        }
        @@media print {
            .btn, .modal, nav, footer, .card-header { display: none !important; }
        }
    </style>
}
