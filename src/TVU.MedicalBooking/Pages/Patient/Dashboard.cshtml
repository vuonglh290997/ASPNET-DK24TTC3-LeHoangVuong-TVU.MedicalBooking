@page
@model TVU.MedicalBooking.Pages.Patient.DashboardModel
@{
    ViewData["Title"] = "Trang chủ bệnh nhân";
}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">
                <i class="fas fa-home"></i> Xin chào, @Model.CurrentUser.FullName
            </h2>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2">Tổng lịch hẹn</h6>
                            <h2 class="mb-0">@Model.TotalAppointments</h2>
                        </div>
                        <i class="fas fa-calendar-check fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2">Chờ duyệt</h6>
                            <h2 class="mb-0">@Model.PendingAppointments</h2>
                        </div>
                        <i class="fas fa-clock fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2">Đã duyệt</h6>
                            <h2 class="mb-0">@Model.ApprovedAppointments</h2>
                        </div>
                        <i class="fas fa-check-circle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2">Hoàn thành</h6>
                            <h2 class="mb-0">@Model.CompletedAppointments</h2>
                        </div>
                        <i class="fas fa-check-double fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-bolt"></i> Thao tác nhanh</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a asp-page="/Patient/BookAppointment" class="btn btn-outline-primary w-100 py-3">
                                <i class="fas fa-calendar-plus fa-2x d-block mb-2"></i>
                                <strong>Đặt lịch khám</strong>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-page="/Patient/MyAppointments" class="btn btn-outline-info w-100 py-3">
                                <i class="fas fa-list fa-2x d-block mb-2"></i>
                                <strong>Lịch của tôi</strong>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-page="/Patient/Profile" class="btn btn-outline-success w-100 py-3">
                                <i class="fas fa-user-edit fa-2x d-block mb-2"></i>
                                <strong>Cập nhật hồ sơ</strong>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-page="/Services" class="btn btn-outline-secondary w-100 py-3">
                                <i class="fas fa-stethoscope fa-2x d-block mb-2"></i>
                                <strong>Xem dịch vụ</strong>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Appointments -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-history"></i> Lịch hẹn gần đây</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Ngày giờ</th>
                                        <th>Bác sĩ</th>
                                        <th>Dịch vụ</th>
                                        <th>Trạng thái</th>
                                        <th>Thanh toán</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in Model.RecentAppointments)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@appointment.AppointmentDate.ToString("dd/MM/yyyy")</strong><br />
                                                <small class="text-muted">@appointment.TimeSlot</small>
                                            </td>
                                            <td>@appointment.Doctor.User.FullName</td>
                                            <td>@appointment.Service.ServiceName</td>
                                            <td>
                                                @if (appointment.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning">Chờ duyệt</span>
                                                }
                                                else if (appointment.Status == "Approved")
                                                {
                                                    <span class="badge bg-success">Đã duyệt</span>
                                                }
                                                else if (appointment.Status == "Completed")
                                                {
                                                    <span class="badge bg-info">Hoàn thành</span>
                                                }
                                                else if (appointment.Status == "Cancelled")
                                                {
                                                    <span class="badge bg-danger">Đã hủy</span>
                                                }
                                                else if (appointment.Status == "Rejected")
                                                {
                                                    <span class="badge bg-dark">Từ chối</span>
                                                }
                                            </td>
                                            <td>
                                                @if (appointment.Payment != null)
                                                {
                                                    @if (appointment.Payment.Status == "Completed")
                                                    {
                                                        <span class="badge bg-success">Đã thanh toán</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning">Chưa thanh toán</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Chưa có</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-page="/Patient/AppointmentDetail"
                                                   asp-route-id="@appointment.AppointmentId"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i> Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Bạn chưa có lịch hẹn nào</p>
                            <a asp-page="/Patient/BookAppointment" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Đặt lịch ngay
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
